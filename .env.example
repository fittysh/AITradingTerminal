# Copy to .env and fill in. Everything is optional: with no .env the bot paper-trades on live Bitget
# public data and writes notifications to state/outbox/ instead of sending them.

# --- mode ---------------------------------------------------------------------------------------
# paper (default): live public data + local simulated fills, no keys needed
# demo:            Bitget demo trading (paptrading header) — needs DEMO API keys below
# live:            real orders — refused unless LIVE_CONFIRM matches AND the edge gate passes
TRADING_MODE=paper
ACCOUNT_SIZE=600
# LIVE_CONFIRM=I-ACCEPT-LIVE-RISK
# EDGE_MIN_TRADES=30
# EDGE_MIN_PROFIT_FACTOR=1.2

# --- Bitget (demo / live only) -----------------------------------------------------------------
BITGET_API_KEY=
BITGET_API_SECRET=
BITGET_API_PASSPHRASE=
# BITGET_DEMO_LEGACY=0        # 1 = old demo accounts: SUSDT-FUTURES + S-prefixed symbols (SBTCSUSDT)
# LEVERAGE=10
# MARGIN_MODE=isolated
# BITGET_TRAIL_RANGE_RATE=1   # trailing-stop callback in percent (framework: 1% behind the peak)

# --- notifications -------------------------------------------------------------------------------
# Telegram: create a bot with @BotFather, then message it and read your chat id from getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gmail: use an App Password (Google account → Security → App passwords), not your login password
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_TO=

# --- tuning (defaults shown) ---------------------------------------------------------------------
# TAKER_FEE=0.0006
# PAPER_SLIPPAGE=0.0002
# HTTP_RPS=12
# HTTP_WORKERS=8
# SCAN_OFFSET=00:02            # 4-hour cycle anchor (MYT): 00:02, 04:02, 08:02, …
# SIGNALS_MAX_AGE_H=8
# UNIVERSE_MIN_VOLUME_USD=0    # framework scans ALL coins; set a floor only if you decide to
# TRADFI_EXTRA=FOO,BAR         # extra bases to exclude as TradFi/RWA
# TRADFI_ALLOW=                # bases to keep even if listed as TradFi
# BOT_HOME=                    # data directory (default: this repo)
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8787
